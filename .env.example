# ---------------------------------------------------------------------------
# Allsafe Electric — environment
# Copy to .env.local and fill in. .env.local is gitignored and must NEVER be
# committed or bundled into client code. Server-only. See planning/docs/11 §3
# and planning/docs/14 "Legal and privacy".
# ---------------------------------------------------------------------------

# Public site origin (no trailing slash). Used for canonicals, sitemap, OG, schema.
NEXT_PUBLIC_SITE_URL=https://allsafehomeservice.com

# --- Google Gemini (image generation for gaps only; build-time / dev machine) ---
# Get one at https://aistudio.google.com/apikey — restrict it to the Generative
# Language API. NEVER paste it into chat, a committed file, or client code.
GEMINI_API_KEY=
# Optional model overrides — verify against the current model list before a run.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_MODEL_HERO=gemini-2.5-flash-image

# --- Google Places API (New) — live reviews feed, server-side only ---
# Restrict to Places API (New). Never exposed to the browser.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Lead delivery (estimate form Server Action) ---
# Leads email to allsafehomeservices@gmail.com (plural — see planning/CLAUDE.md §3)
LEAD_EMAIL_TO=allsafehomeservices@gmail.com
LEAD_EMAIL_FROM=info@allsafehomeservice.com
# Transactional email provider key (Resend / Postmark / SES — pick one at wiring time)
RESEND_API_KEY=
# Housecall Pro + Built Right Digital lead-log webhooks
HCP_LEAD_WEBHOOK_URL=
BRD_LEAD_LOG_WEBHOOK_URL=

# --- Analytics (public IDs — safe in client) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CALLRAIL_SWAP_SCRIPT=
