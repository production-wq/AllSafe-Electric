{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "rebuild/allsafe-nextjs": true
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.allsafehomeservice.com" }],
      "destination": "https://allsafehomeservice.com/:path*",
      "permanent": true
    }
  ]
}
